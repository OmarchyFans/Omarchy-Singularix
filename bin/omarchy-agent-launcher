#!/bin/bash
#
# omarchy-agent-launcher — spin up an AI agent from a keybinding.
#
# A gum form (in a floating Omarchy terminal) asks for: the agent (Hermes Agent,
# OpenClaw), where it runs (local shell, Docker, Fly.io Sprite), the model and
# how to sign in (browser OAuth or API key), the skills to preload, and the job
# description. The answers are saved as a named profile, the agent gets its own
# isolated home directory, and a session opens in a new terminal window.
#
# Usage:
#   omarchy-agent-launcher                 interactive menu (new / relaunch / manage)
#   omarchy-agent-launcher new             the new-agent form
#   omarchy-agent-launcher launch <name>   open (or focus) the agent's window and start it
#   omarchy-agent-launcher chat <name>     same: focus the running session, or start one
#   omarchy-agent-launcher focus-window <title>   focus a window by exact title (switches workspace)
#   omarchy-agent-launcher manage          show / edit job / sign in / remove / destroy
#   omarchy-agent-launcher list | show <name> | job <name> | sign-in <name>
#   omarchy-agent-launcher remove <name>   forget a saved agent (and its local home)
#   omarchy-agent-launcher destroy <name>  also destroy its container / sprite
#   omarchy-agent-launcher console <name>  shell into the agent's sprite
#   omarchy-agent-launcher stop <name>     end the agent's session (the saved agent stays)
#   omarchy-agent-launcher switch          graphical picker: jump to an agent's chat
#   omarchy-agent-launcher status --json   every agent with status, window, blockers, tasks
#   omarchy-agent-launcher event <agent> <kind> "<message>" [--task T] [--level info|warn|blocker] [--key K]
#                                          append to the event log (agents and hooks may call this;
#                                          OAL_AGENT holds the agent's own name inside its session)
#   omarchy-agent-launcher settings get|set <key> [value]   e.g. notify_blockers false
#
# Jarvis (chief of staff) and the fleet:
#   omarchy-agent-launcher jarvis [chat]             open Jarvis (set up on the local GPU the first time)
#   omarchy-agent-launcher jarvis setup [BACKEND] [MODEL]   choose what Jarvis runs on
#   omarchy-agent-launcher jarvis brief              plain status brief: agents, blockers, tokens, USD
#   omarchy-agent-launcher jarvis ask "<question>"   one answer from Jarvis, no window
#   omarchy-agent-launcher delegate --backend B --name N --task-title T (--job-stdin|--job-env|--job-file F) [--wait] [--model M]
#                                          hand a job to a worker agent on that backend
#   omarchy-agent-launcher result <name> [--list]    a worker's latest unattended run output
#   omarchy-agent-launcher usage [--json]            tokens and USD: totals, per agent, per task
#   omarchy-agent-launcher backends list|show|add|remove|deploy|start|stop|test [id]   models to hand work to
#     add: --id I --kind endpoint|modal-dedicated|modal-sandbox --model M [--url U --key-env] [--gpu G --gpu-count N]
#          [--scaledown MIN] [--timeout-hours H] [--ctx N] [--input-per-m $ --output-per-m $]
#   omarchy-agent-launcher modal status|gpus|setup   the modal CLI, GPU prices, sign-in
#   omarchy-agent-launcher local-server status|start|tune|untune [--ctx N] [--kv q8_0|q4_0|f16] [--slots N] [--model FILE]
#                                          the offline llama.cpp server of the Omarchy local agent
#
# Non-interactive (used by the Quickshell panel, handy for scripts):
#   omarchy-agent-launcher info --json     agents, runtimes, providers, models, skills, saved agents
#   omarchy-agent-launcher create --name N --agent hermes|openclaw --runtime local|docker|sprite \
#       --provider P --auth oauth|api-key|none --model M [--base-url U] [--skill S]... \
#       --mode interactive|unattended (--job-file F | --job-stdin | --job-env) [--api-key-env] [--launch]
#     --api-key-env reads the key from $OAL_API_KEY, --job-env the job from $OAL_JOB
#     (never from argv); --launch then
#     opens the session in a floating terminal (sign-in happens there if needed).
#
# Sessions run inside tmux (session oal-<name>, on the agent's own tmux server at
# ~/.local/state/omarchy-agent-launcher/tmux/oal-<name>.sock) in a terminal titled
# "Agent · <name>". Closing the window detaches; launch/chat reattaches.
#
# Flags: --popup   re-open this command in a floating terminal (for the wizard/menus)
#        --inline  run the agent session in this terminal instead of its own window
#        --dry-run print every command instead of running it (no side effects)
set -uo pipefail

OAL_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
OAL_ROOT="$(cd -- "$(dirname -- "$OAL_SELF")/.." && pwd)"
OAL_LIB="$OAL_ROOT/lib"
OAL_VERSION=$(jq -r .version "$OAL_ROOT/manifest.json" 2>/dev/null || echo dev)

source "$OAL_LIB/common.sh"
source "$OAL_LIB/providers.sh"
source "$OAL_LIB/models.sh"
source "$OAL_LIB/events.sh"
source "$OAL_LIB/local.sh"
source "$OAL_LIB/backends.sh"
source "$OAL_LIB/modal.sh"
source "$OAL_LIB/usage.sh"
source "$OAL_LIB/fallback.sh"
source "$OAL_LIB/jarvis.sh"
# Tests replace the gum wrappers with scripted answers (see tests/run.sh).
# shellcheck source=/dev/null
[[ -n ${OAL_UI_STUBS:-} ]] && source "$OAL_UI_STUBS"

POPUP=0 INLINE=0 JSON=0 CMD=() OPTS=()
while (($#)); do
  case "$1" in
    --popup)   POPUP=1 ;;
    --inline)  INLINE=1 ;;
    --dry-run) OAL_DRY_RUN=1 ;;
    --json)    JSON=1 ;;
    -h|--help) sed -n '3,47p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --version) echo "omarchy-agent-launcher $OAL_VERSION"; exit 0 ;;
    --name|--agent|--runtime|--provider|--auth|--model|--base-url|--mode|--skill|--job-file|--task|--level|--key|--ctx|--kv|--slots|\
    --backend|--parent|--role|--task-title|--id|--kind|--label|--url|--gpu|--gpu-count|--scaledown|--timeout-hours|--input-per-m|--output-per-m)
               OPTS+=("$1" "${2:-}"); shift ;;   # valued options (create, delegate, backends add, local-server)
    --*)       OPTS+=("$1") ;;                    # create's flags
    *)         CMD+=("$1") ;;
  esac
  shift
done
export OAL_DRY_RUN

# --popup: float this command in an Omarchy terminal, then run it there.
if (( POPUP )); then
  have omarchy-launch-tui || fail "--popup needs Omarchy (omarchy-launch-tui not found)"
  rest=(); (( OAL_DRY_RUN )) && rest+=(--dry-run); (( INLINE )) && rest+=(--inline)
  exec omarchy-launch-tui --app-id=TUI.float env OAL_POPUP=1 "${BASH_SOURCE[0]}" "${rest[@]}" "${CMD[@]}" "${OPTS[@]}"
fi

# In a popup the window closes on exit, so hold it open after a failure.
if [[ ${OAL_POPUP:-0} == 1 ]]; then
  fail() { warn "$*"; hr; read -rp "Press Enter to close…" _; exit 1; }
  trap 'if (( $? != 0 && $? != 130 )); then read -rp "Press Enter to close…" _; fi' EXIT
fi

need jq
ui_need() { need gum; [[ -f /usr/share/omarchy/bin/omarchy-restart-gum ]] && source omarchy-restart-gum 2>/dev/null; return 0; }   # gum + theme colors, interactive commands only
opt_flag() { local o; for o in "${OPTS[@]}"; do [[ $o == "$1" ]] && return 0; done; return 1; }
opt_value() { local i; for ((i=0; i<${#OPTS[@]}; i++)); do [[ ${OPTS[i]} == "$1" ]] && { printf '%s' "${OPTS[i+1]:-}"; return 0; }; done; return 1; }

# ================================================================ helpers ====
agent_label() { case "$1" in hermes) echo "Hermes Agent";; openclaw) echo "OpenClaw";; *) echo "$1";; esac; }
runtime_label() { case "$1" in local) echo "local shell";; docker) echo "Docker container";; sprite) echo "Fly.io Sprite";; *) echo "$1";; esac; }

# Load adapters for a profile (sets AGENT_BIN, rt_* functions, ...).
load_profile_adapters() {
  local agent runtime
  agent=$(profile_get "$1" agent); runtime=$(profile_get "$1" runtime)
  [[ -f $OAL_LIB/agents/$agent.sh ]] || fail "unknown agent '$agent' in profile $1"
  [[ -f $OAL_LIB/runtimes/$runtime.sh ]] || fail "unknown runtime '$runtime' in profile $1"
  load_agent "$agent"; load_runtime "$runtime"
}

# Status line for a runtime × agent combination (for the form's annotations).
runtime_status() { # runtime_status <agent> <runtime>
  ( load_agent "$1"; load_runtime "$2"; rt_check ) 2>/dev/null || true
}

edit_job_file() { # edit_job_file <path>
  local editor=${VISUAL:-${EDITOR:-}}
  if [[ -z $editor ]]; then for e in nvim vim nano vi; do have "$e" && { editor=$e; break; }; done; fi
  [[ -n $editor ]] || fail "no editor found; set \$EDITOR"
  local -a ed; read -ra ed <<<"$editor"      # $EDITOR may carry flags, e.g. "omarchy-launch-editor --inline"
  "${ed[@]}" "$1"
}

# ===================================================================== new ====
cmd_new() {
  ui_need
  title "New agent"
  hr

  # 1. Name -----------------------------------------------------------------
  local name
  name=$(ask "Name for this agent" "e.g. release-notes-bot" "agent-$(date +%m%d%H%M)")
  name=$(slugify "$name"); [[ -n $name ]] || fail "a name is required"
  if profile_exists "$name"; then confirm "'$name' exists. Overwrite its settings?" || exit 130; fi

  # 2. Agent ----------------------------------------------------------------
  local agent pick
  pick=$(choose "Agent" \
    "hermes    Hermes Agent (Nous Research)   $( have hermes && echo installed || echo 'not installed locally')" \
    "openclaw  OpenClaw                        $( have openclaw && echo installed || echo 'not installed locally')")
  [[ -n $pick ]] || exit 130
  agent=${pick%% *}

  # 3. Runtime --------------------------------------------------------------
  local runtime
  pick=$(choose "Where should it run?" \
    "local    Shell on this machine          [$(runtime_status "$agent" local)]" \
    "docker   Official Docker image          [$(runtime_status "$agent" docker)]" \
    "sprite   Fly.io Sprite (cloud VM)       [$(runtime_status "$agent" sprite)]")
  [[ -n $pick ]] || exit 130
  runtime=${pick%% *}
  load_agent "$agent"; load_runtime "$runtime"
  if [[ $runtime == local ]] && ! agent_available_local; then agent_install_hint; fail "cannot run $agent locally"; fi
  if [[ $runtime == docker ]] && ! have docker; then fail "docker is not installed (try: omarchy install docker)"; fi
  if [[ $runtime == sprite ]] && ! have sprite; then fail "$SPRITE_INSTALL_HINT"; fi

  # 4. Provider -------------------------------------------------------------
  local -a rows=(); local id
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    local tag=""
    { [[ $agent == hermes ]] && provider_hermes_oauth "$id"; } || { [[ $agent == openclaw ]] && provider_openclaw_oauth "$id"; } && tag=" · browser sign-in"
    [[ $(provider_env "$id") != - ]] && tag="$tag · API key"
    rows+=("$(printf '%-13s %s%s' "$id" "$(provider_label "$id")" "$tag")")
  done < <(providers_for_agent "$agent")
  pick=$(choose "Model provider" "${rows[@]}"); [[ -n $pick ]] || exit 130
  local provider=${pick%% *}

  # 5. Auth -----------------------------------------------------------------
  local auth=none var base_url; var=$(provider_env "$provider"); base_url=$(provider_base_url "$provider")
  local -a auths=()
  if { [[ $agent == hermes ]] && provider_hermes_oauth "$provider"; } || { [[ $agent == openclaw ]] && provider_openclaw_oauth "$provider"; }; then
    auths+=("oauth      Sign in with your account in the browser")
  fi
  if [[ $var != - ]]; then
    if [[ -n $(secret_get "$var") ]]; then
      auths+=("saved-key  Use the saved $var" "new-key    Enter a new $var")
    else
      auths+=("new-key    Enter an API key ($var)")
    fi
  fi
  if (( ${#auths[@]} == 0 )); then
    auth=none
  else
    pick=$(choose "How should $agent authenticate with $(provider_label "$provider")?" "${auths[@]}"); [[ -n $pick ]] || exit 130
    case "${pick%% *}" in
      oauth)     auth=oauth ;;
      saved-key) auth=api-key ;;
      new-key)   auth=api-key
                 local key; key=$(ask_secret "$var" "paste the key"); [[ -n $key ]] || fail "no key given"
                 secret_set "$var" "$key"; info "saved to $OAL_SECRETS (mode 600)" ;;
    esac
  fi
  if [[ $provider == ollama ]]; then
    base_url=$(ask "Ollama endpoint" "" "$base_url")
  fi

  # 6. Model (newest models from models.dev with prices per million tokens) --
  [[ ${OAL_OFFLINE:-0} == 1 ]] || models_catalog_refresh >/dev/null 2>&1 || true
  local -a models=(); mapfile -t models < <(models_for_provider "$provider" | jq -c '.[]' | while IFS= read -r m; do model_line "$m"; done)
  pick=$(choose "Model  (prices: USD per 1M tokens, from models.dev)" "${models[@]}" "Custom…"); [[ -n $pick ]] || exit 130
  local model=${pick%% *}
  [[ $pick == "Custom…" ]] && { model=$(ask "Model id" "$(models_default_for_provider "$provider")"); [[ -n $model ]] || fail "a model id is required"; }

  # 7. Skills ---------------------------------------------------------------
  local skills="" ; local -a available=(); mapfile -t available < <(agent_skills_list)
  if [[ $agent == hermes && $runtime == local ]] && confirm "Install a skill from the hub first? (hermes skills install …)"; then
    local ident; ident=$(ask "Skill identifier" "e.g. openai/skills/skill-creator or a SKILL.md URL")
    [[ -n $ident ]] && { run hermes skills install "$ident" --yes || warn "skill install failed"; mapfile -t available < <(agent_skills_list); }
  fi
  if (( ${#available[@]} )); then
    skills=$(choose_many "Skills to preload (space toggles, enter confirms)" "${available[@]}") || true
  else
    info "No local skills found for $agent; skipping skill selection."
  fi

  # 8. Job description ------------------------------------------------------
  mkdir -p "$OAL_PROFILES"; local jobf; jobf=$(job_path "$name")
  pick=$(choose "Job description / instructions" \
    "editor   Write it in \$EDITOR" \
    "type     Type it here (multi-line, Ctrl-D to finish)" \
    "file     Use an existing Markdown or text file"); [[ -n $pick ]] || exit 130
  case "${pick%% *}" in
    editor) [[ -s $jobf ]] || printf '# Job for %s\n\nDescribe what this agent must accomplish, the constraints, and what "done" looks like.\n' "$name" >"$jobf"
            edit_job_file "$jobf" ;;
    type)   gum write --header "Job description" --placeholder "What should $name do?" --width 100 --height 15 >"$jobf" ;;
    file)   local src; src=$(gum file "$HOME"); [[ -f $src ]] || fail "no file chosen"; cp -f "$src" "$jobf" ;;
  esac
  [[ -s $jobf ]] || fail "the job description is empty"

  # 9. Mode -----------------------------------------------------------------
  pick=$(choose "Session mode" \
    "interactive  Open a chat session that starts on the job" \
    "unattended   Run the job once, unattended, and show the result"); [[ -n $pick ]] || exit 130
  local mode=${pick%% *}

  # 10. Summary + save ------------------------------------------------------
  hr; title "Summary"
  info "name      $name"
  info "agent     $(agent_label "$agent")  on  $(runtime_label "$runtime")"
  info "model     $provider / $model   (auth: $auth)"
  info "skills    ${skills:-none}" | tr '\n' ' '; echo
  info "job       $jobf"
  info "mode      $mode"
  hr
  profile_write "$name" "$agent" "$runtime" "$provider" "$auth" "$model" "$base_url" "$mode" "$skills"
  info "saved $(profile_path "$name")"
  confirm "Launch $name now?" || { info "Saved. Launch later with: omarchy-agent-launcher launch $name"; exit 0; }
  cmd_launch "$name"
}

# ================================================================== launch ====
# Provision + prepare + first-time sign-in, in the current terminal.
prepare_session() { # prepare_session <name>
  local name=$1
  if [[ $(profile_get "$name" provider) == local ]]; then
    local_ensure_running || { event_emit "$name" blocker "Local GPU server is not running (systemctl --user start omarchy-local-agent)" --level blocker --key prepare; return 1; }
    if [[ $(profile_get "$name" agent) == hermes ]] && ! local_status_json | jq -e '.agent_ready' >/dev/null; then
      event_emit "$name" blocker "Local server context is too small for Hermes: run  omarchy-agent-launcher local-server tune --ctx 32768" --level blocker --key prepare
      return 1
    fi
  fi
  agent_provision "$name"
  if ! rt_prepare "$name"; then
    event_emit "$name" blocker "Runtime could not be prepared ($(profile_get "$name" runtime))" --level blocker --key prepare
    return 1
  fi
  if [[ $(profile_get "$name" auth) == oauth && $(profile_get "$name" signed_in) != true ]]; then
    local plabel; plabel=$(provider_label "$(profile_get "$name" provider)")
    event_emit "$name" signin_required "Sign-in required ($plabel): open the agent's window and finish the browser sign-in" --level blocker --key signin
    hr; say "First launch: sign in to $plabel."
    say "(This prompt lives in the agent's tmux session: close or switch windows freely and come back.)"
    if rt_oauth "$name"; then profile_set "$name" signed_in true; event_emit "$name" signed_in "Signed in to $plabel"
    else warn "sign-in did not complete; launching anyway"; fi
  fi
}

cmd_launch() {
  local name=$1; profile_exists "$name" || fail "no saved agent named '$name' (see: omarchy-agent-launcher list)"
  load_profile_adapters "$name"
  if (( INLINE )); then
    title "Launching $name ($(agent_label "$(profile_get "$name" agent)") on $(runtime_label "$(profile_get "$name" runtime)"))"
    prepare_session "$name"
    local -a cmd; mapfile -t cmd < <(rt_cmd "$name" 0)
    hr
    if (( OAL_DRY_RUN )); then say "[dry-run] would launch:"; show_cmd "${cmd[@]}"; return 0; fi
    exec "${cmd[@]}"
  fi
  open_agent_window "$name"
}

# One run of the agent's session in this terminal: prepare, start, log events,
# and for an unattended run keep a copy of the output under
# <agent home>/runs/<timestamp>.log so `result NAME` (and Jarvis) can read it.
# session_run_once <name> <resume:0|1>  -> the agent's exit code
session_run_once() {
  local name=$1 resume=${2:-0} code mode; mode=$(profile_get "$name" mode)
  if (( ! resume )); then prepare_session "$name" || true; fi
  local -a cmd; mapfile -t cmd < <(rt_cmd "$name" "$resume")
  export OAL_AGENT="$name" PATH="$OAL_ROOT/bin:$PATH"
  event_emit "$name" session_started "$( (( resume )) && echo "Chat resumed" || echo "Session started" ) ($mode)" --task "$(job_title "$name")"
  hr
  local runlog=""
  if [[ $mode == unattended && $resume == 0 ]]; then
    runlog="$(stage_dir "$name")/runs/$(date +%Y%m%d-%H%M%S).log"; mkdir -p "$(dirname "$runlog")"
    "${cmd[@]}" 2>&1 | tee "$runlog"; code=${PIPESTATUS[0]}
  else
    "${cmd[@]}"; code=$?
  fi
  hr
  if (( code == 0 )); then
    say "Session ended."
    if [[ -n $runlog ]]; then
      event_emit "$name" job_done "Unattended run finished · omarchy-agent-launcher result $name" --task "$(job_title "$name")"
    else
      event_emit "$name" session_exited "Session ended" --code 0
    fi
  else
    say "Session ended with exit code $code."
    event_emit "$name" session_exited "Session exited with code $code" --level blocker --key exit --code "$code"
  fi
  cmd_kanban_sync "$name" >/dev/null 2>&1 || true
  return "$code"
}

# Runs inside the agent's tmux session: the whole lifecycle, then a menu so
# the window never just vanishes on exit.
cmd_session() {
  ui_need
  local name=$1; profile_exists "$name" || fail "no saved agent named '$name'"
  load_profile_adapters "$name"
  # If the tmux session is killed from outside (kill-session, a closed pane, a
  # logout), the agent goes with it silently; say so where the user looks.
  trap 'trap - HUP TERM; event_emit "$name" session_exited "Session was killed from outside (tmux session ended); Chat starts it again" --level blocker --key exit --code 129; exit 129' HUP TERM
  local resume=0
  while :; do
    title "$name  ·  $(agent_label "$(profile_get "$name" agent)") on $(runtime_label "$(profile_get "$name" runtime)")"
    session_run_once "$name" "$resume" || true
    local pick
    pick=$(choose "What next?" \
      "chat     Open a chat that continues this agent's conversation" \
      "restart  Run the job again from the start" \
      "close    Close this window (the saved agent stays)") || pick=close
    case "${pick%% *}" in
      chat)    resume=1 ;;
      restart) resume=0 ;;
      *)       break ;;
    esac
  done
}

cmd_sign_in() {
  local name=$1; profile_exists "$name" || fail "no saved agent named '$name'"
  load_profile_adapters "$name"
  [[ $(profile_get "$name" auth) == oauth ]] || fail "$name uses $(profile_get "$name" auth), not OAuth"
  agent_provision "$name"; rt_prepare "$name"
  rt_oauth "$name" && profile_set "$name" signed_in true
}

# ================================================================== manage ====
cmd_list() {
  local n; local any=0
  while IFS= read -r n; do [[ -n $n ]] || continue; any=1; profile_summary "$n"; done < <(profile_list)
  (( any )) || say "No saved agents yet. Run: omarchy-agent-launcher new"
}
cmd_show() {
  profile_exists "$1" || fail "no saved agent named '$1'"
  jq . "$(profile_path "$1")"; hr; say "--- job ($(job_path "$1")) ---"; cat "$(job_path "$1")"
}
# job <name>                 open the job in $EDITOR
# job <name> --print         print it (scripts, no terminal needed)
# job <name> --job-file F    replace it from a file
# job <name> --job-stdin     replace it from stdin
cmd_job() {
  local name=$1; profile_exists "$name" || fail "no saved agent named '$name'"
  local jobf; jobf=$(job_path "$name")
  if opt_flag --print; then [[ -f $jobf ]] && cat "$jobf"; return 0; fi
  local src
  if src=$(opt_value --job-file); then [[ -f $src ]] || fail "no such file: $src"; run cp -f "$src" "$jobf"
  elif opt_flag --job-stdin; then (( OAL_DRY_RUN )) && { say "[dry-run] would replace the job from stdin"; return 0; }; cat >"$jobf"
  else edit_job_file "$jobf"; return; fi
  event_emit "$name" note "Job updated" 2>/dev/null || true
  say "job updated for $name"
}

cmd_remove() {
  local name=$1; profile_exists "$name" || fail "no saved agent named '$name'"
  if ! opt_flag --yes; then ui_need; confirm "Forget '$name' and delete its local agent home?" || exit 130; fi
  session_kill "$name" || true
  run rm -rf "$(stage_dir "$name")"
  run rm -f "$(profile_path "$name")" "$(job_path "$name")"
  event_emit "$name" removed "Agent removed"
  [[ -s $OAL_STATE/kanban-cursors.json ]] && { tmp=$(mktemp); jq --arg n "$name" 'del(.[$n])' "$OAL_STATE/kanban-cursors.json" >"$tmp" && mv -f "$tmp" "$OAL_STATE/kanban-cursors.json"; }
  say "removed $name"
}
cmd_stop() {
  local name=$1; profile_exists "$name" || fail "no saved agent named '$name'"
  if session_alive "$name"; then
    event_emit "$name" stopped "Session stopped by the user"
    session_kill "$name"; say "stopped $name"
  else say "$name is not running"; fi
}
cmd_destroy() {
  local name=$1; profile_exists "$name" || fail "no saved agent named '$name'"
  load_profile_adapters "$name"
  if ! opt_flag --yes; then ui_need; confirm "Destroy the $(runtime_label "$(profile_get "$name" runtime)") for '$name' (remote data is lost) and forget it?" || exit 130; fi
  session_kill "$name" || true
  rt_destroy "$name"
  run rm -rf "$(stage_dir "$name")"
  run rm -f "$(profile_path "$name")" "$(job_path "$name")"
  event_emit "$name" destroyed "Agent destroyed (runtime removed)"
  say "destroyed and removed $name"
}
cmd_console() {
  local name=$1; profile_exists "$name" || fail "no saved agent named '$name'"
  load_profile_adapters "$name"
  [[ $(profile_get "$name" runtime) == sprite ]] || fail "console is only for sprite agents"
  rt_console "$name"
}

cmd_manage() {
  ui_need
  local -a rows=(); local n
  while IFS= read -r n; do [[ -n $n ]] && rows+=("$(profile_summary "$n")"); done < <(profile_list)
  (( ${#rows[@]} )) || { say "No saved agents yet."; return; }
  local pick; pick=$(choose "Which agent?" "${rows[@]}"); [[ -n $pick ]] || return
  n=${pick%% *}
  local action; action=$(choose "$n" "launch (open or focus the agent window)" "show" "edit job" "sign in again" "remove (forget + delete local home)" "destroy (also remove container / sprite)" "console (sprite shell)")
  case "${action%% *}" in
    launch) cmd_launch "$n" ;; show) cmd_show "$n" ;; edit) cmd_job "$n" ;; sign) cmd_sign_in "$n" ;;
    remove) cmd_remove "$n" ;; destroy) cmd_destroy "$n" ;; console) cmd_console "$n" ;;
  esac
}

cmd_menu() {
  ui_need
  local -a rows=("new       New agent…"); local n
  while IFS= read -r n; do [[ -n $n ]] && rows+=("▶ $(profile_summary "$n")"); done < <(profile_list)
  (( ${#rows[@]} > 1 )) && rows+=("manage    Manage saved agents…")
  local pick; pick=$(choose "Omarchy Agent Launcher $OAL_VERSION" "${rows[@]}"); [[ -n $pick ]] || exit 130
  case "$pick" in
    new*)    cmd_new ;;
    manage*) cmd_manage ;;
    "▶ "*)   read -r n _ <<<"${pick#▶ }"; cmd_launch "$n" ;;
  esac
}

# ==================================================== non-interactive API ====
# Everything the single-page panel needs, as one JSON document.
cmd_info() {
  (( JSON )) || { say "use: omarchy-agent-launcher info --json"; return 1; }
  [[ ${OAL_OFFLINE:-0} == 1 ]] || models_catalog_refresh >/dev/null 2>&1 || true
  local a r id row
  {
    echo '{"version":'"$(jq -Rn --arg v "$OAL_VERSION" '$v')"',"agents":['
    local first=1
    for a in hermes openclaw; do
      (( first )) || echo ','; first=0
      ( load_agent "$a"
        printf '{"id":"%s","label":%s,"installed":%s,"runtimes":{' "$a" "$(jq -Rn --arg v "$AGENT_LABEL" '$v')" "$(agent_available_local && echo true || echo false)"
        local rf=1
        for r in local docker sprite; do
          (( rf )) || printf ','; rf=0
          local st ok=true; st=$( load_runtime "$r"; rt_check 2>/dev/null ) || ok=false
          printf '"%s":{"ok":%s,"status":%s}' "$r" "$ok" "$(jq -Rn --arg v "$st" '$v')"
        done
        printf '},"skills":%s}' "$(agent_skills_list | jq -R . | jq -sc .)" )
    done
    echo '],"providers":['
    first=1
    for row in "${PROVIDERS[@]}"; do
      id=${row%%|*}; (( first )) || echo ','; first=0
      jq -nc --arg id "$id" --arg label "$(provider_label "$id")" --arg env "$(provider_env "$id")" \
        --arg hermes "$(provider_hermes "$id")" --argjson hoauth "$(provider_hermes_oauth "$id" && echo true || echo false)" \
        --arg openclaw "$(provider_openclaw "$id")" --argjson ooauth "$(provider_openclaw_oauth "$id" && echo true || echo false)" \
        --arg base_url "$(provider_base_url "$id")" --arg default_model "$(models_default_for_provider "$id")" \
        --argjson models "$(models_for_provider "$id")" \
        --argjson saved_key "$([[ $(provider_env "$id") != - && -n $(secret_get "$(provider_env "$id")") ]] && echo true || echo false)" \
        '{id:$id,label:$label,env:$env,hermes:$hermes,hermes_oauth:$hoauth,openclaw:$openclaw,openclaw_oauth:$ooauth,base_url:$base_url,default_model:$default_model,models:$models,saved_key:$saved_key}'
    done
    echo '],"saved":['
    first=1
    while IFS= read -r id; do [[ -n $id ]] || continue; (( first )) || echo ','; first=0; jq -c . "$(profile_path "$id")"; done < <(profile_list)
    echo '],"local":'"$(local_status_json)"
    echo ',"backends":'"$(backends_list_json)"',"gpus":'"$(modal_gpus_json)"',"modal":'"$(modal_status_json quick)"',"jarvis":'"$(jarvis_status_json)"
    echo ',"catalog":{"source":"'"$(models_catalog_available && echo models.dev || echo static)"'","updated":'"$(jq -Rn --arg v "$(models_catalog_updated || true)" '$v')"',"url":"https://models.dev"}'
    echo ',"paths":{"config":'"$(jq -Rn --arg v "$OAL_CONF" '$v')"',"data":'"$(jq -Rn --arg v "$OAL_DATA" '$v')"'}}'
  } | jq .
}

# Save (and optionally launch) an agent from flags: no prompts at all.
cmd_create() {
  local name='' agent='' runtime='' provider='' auth=none model='' base_url=- mode=interactive job_file='' job_stdin=0 job_env=0 key_env=0 launch=0
  local backend='' parent='' role='' task_title=''
  local -a skills=()
  local i=0 n=${#OPTS[@]} o v
  while (( i < n )); do
    o=${OPTS[i]}; v=${OPTS[i+1]:-}
    case "$o" in
      --name) name=$v; ((i+=2)) ;;       --agent) agent=$v; ((i+=2)) ;;
      --runtime) runtime=$v; ((i+=2)) ;; --provider) provider=$v; ((i+=2)) ;;
      --auth) auth=$v; ((i+=2)) ;;       --model) model=$v; ((i+=2)) ;;
      --base-url) base_url=$v; ((i+=2)) ;; --mode) mode=$v; ((i+=2)) ;;
      --skill) skills+=("$v"); ((i+=2)) ;; --job-file) job_file=$v; ((i+=2)) ;;
      --backend) backend=$v; ((i+=2)) ;; --parent) parent=$v; ((i+=2)) ;;
      --role) role=$v; ((i+=2)) ;;       --task-title) task_title=$v; ((i+=2)) ;;
      --job-stdin) job_stdin=1; ((i+=1)) ;; --job-env) job_env=1; ((i+=1)) ;;
      --api-key-env) key_env=1; ((i+=1)) ;;
      --launch) launch=1; ((i+=1)) ;;
      *) fail "create: unknown option $o" ;;
    esac
  done
  name=$(slugify "$name"); [[ -n $name ]] || fail "create: --name is required"
  if [[ -n $backend ]]; then
    # A backend decides provider, sign-in, model, and URL (lib/backends.sh).
    local r; r=$(backend_resolve "$backend" "$model") || exit 1
    provider=$(jq -r .provider <<<"$r"); auth=$(jq -r .auth <<<"$r"); model=$(jq -r .model <<<"$r"); base_url=$(jq -r .base_url <<<"$r")
    [[ -n $agent ]] || agent=hermes; [[ -n $runtime ]] || runtime=local
  fi
  [[ $provider == endpoint && $agent != hermes ]] && fail "create: endpoint backends are Hermes-only"
  [[ -f $OAL_LIB/agents/$agent.sh ]] || fail "create: --agent must be hermes or openclaw"
  [[ -f $OAL_LIB/runtimes/$runtime.sh ]] || fail "create: --runtime must be local, docker, or sprite"
  provider_label "$provider" >/dev/null 2>&1 || fail "create: unknown --provider '$provider'"
  [[ $auth == oauth || $auth == api-key || $auth == none ]] || fail "create: --auth must be oauth, api-key, or none"
  [[ $mode == interactive || $mode == unattended ]] || fail "create: --mode must be interactive or unattended"
  [[ -n $model ]] || model=$(models_default_for_provider "$provider")
  [[ -n $base_url && $base_url != - ]] || base_url=$(provider_base_url "$provider")
  local var; var=$(provider_env "$provider")
  if (( key_env )); then
    [[ -n ${OAL_API_KEY:-} ]] || fail "create: --api-key-env given but \$OAL_API_KEY is empty"
    [[ $var != - ]] || fail "create: $provider takes no API key"
    secret_set "$var" "$OAL_API_KEY"; auth=api-key
  fi
  if [[ $auth == api-key && $provider != endpoint ]]; then
    [[ $var != - ]] || fail "create: $provider has no API key auth"
    [[ -n $(secret_get "$var") ]] || fail "create: no saved $var; pass --api-key-env with \$OAL_API_KEY set"
  fi
  mkdir -p "$OAL_PROFILES"
  if (( job_stdin )); then cat >"$(job_path "$name")"; elif (( job_env )); then printf '%s\n' "${OAL_JOB:-}" >"$(job_path "$name")"; elif [[ -n $job_file ]]; then cp -f "$job_file" "$(job_path "$name")"; else fail "create: --job-file, --job-stdin, or --job-env is required"; fi
  [[ -s $(job_path "$name") ]] || fail "create: the job description is empty"
  profile_write "$name" "$agent" "$runtime" "$provider" "$auth" "$model" "$base_url" "$mode" "$(printf '%s\n' "${skills[@]}")"
  [[ -n $backend ]] && profile_set "$name" backend "$(jq -Rn --arg v "$backend" '$v')"
  [[ -n $parent ]] && profile_set "$name" parent "$(jq -Rn --arg v "$parent" '$v')"
  [[ -n $role ]] && profile_set "$name" role "$(jq -Rn --arg v "$role" '$v')"
  [[ -n $task_title ]] && profile_set "$name" task_title "$(jq -Rn --arg v "$task_title" '$v')"
  event_emit "$name" created "Agent created: $agent on $runtime, ${backend:-$provider}/$model ($mode)${parent:+ · for $parent}" --task "${task_title:-$(job_title "$name")}"
  (( JSON )) && jq -c . "$(profile_path "$name")" || say "saved $name"
  if (( launch )); then
    unset OAL_API_KEY OAL_JOB     # the agent window must not inherit them
    cmd_launch "$name"             # opens (or focuses) the agent window; --inline runs here
  fi
}

# ============================================================ status & events ====
# Kanban mirror: filled in by lib/agents/hermes.sh (agent_kanban_sync); no-op otherwise.
cmd_kanban_sync() { # cmd_kanban_sync [name]
  local n
  for n in ${1:-$(profile_list)}; do
    profile_exists "$n" || continue
    ( load_agent "$(profile_get "$n" agent)"; declare -F agent_kanban_sync >/dev/null && agent_kanban_sync "$n" ) || true
  done
}

# Projects across every saved agent: merged into status --json's "projects"
# array. Delegates per-agent extraction to agent_projects_json (adapter-
# specific; Hermes-only today, no-op elsewhere).
cmd_projects_json() {
  local n out="[]" part
  while IFS= read -r n; do
    [[ -n $n ]] || continue; profile_exists "$n" || continue
    part=$( ( load_agent "$(profile_get "$n" agent)"; declare -F agent_projects_json >/dev/null && agent_projects_json "$n" ) 2>/dev/null )
    [[ $part == \[*\] ]] || continue
    out=$(jq -c --argjson p "$part" '. + $p' <<<"$out")
  done < <(profile_list)
  printf '%s' "$out"
}

# Everything the dashboard needs, as one compact JSON document: agents (status,
# window, tasks, blockers), Jarvis, usage (tokens + USD), backends, projects
# (waterfall phase per registered project). No network.
cmd_status_json() {
  cmd_kanban_sync >/dev/null 2>&1 || true
  local clients="[]"; have hyprctl && clients=$(hyprctl clients -j 2>/dev/null || echo "[]")
  local recent blockers; recent=$(events_recent 4000); blockers=$(blockers_json)
  local projects; projects=$(cmd_projects_json)
  local n running window tasks_extra p
  # What the local server actually serves; a saved agent may pin an older file name.
  local served=""
  if declare -F local_online >/dev/null && local_online; then served=$(local_models_json | jq -r '.[0].id // ""' 2>/dev/null || true); fi
  {
    printf '{"version":%s,"blockers":%s,"jarvis":%s,"usage":%s,"backends":%s,"modal":%s,"projects":%s,"agents":[' \
      "$(jq -Rn --arg v "$OAL_VERSION" '$v')" "$(jq 'length' <<<"$blockers")" "$(jarvis_status_json)" "$(usage_json)" "$(backends_list_json)" "$(modal_status_json quick)" "$projects"
    local first=1
    while IFS= read -r n; do
      [[ -n $n ]] || continue; (( first )) || printf ','; first=0
      running=false; session_alive "$n" && running=true
      window=$(jq -r --arg t "$(window_title "$n")" '.[] | select(.initialTitle==$t or .title==$t) | .address' <<<"$clients" 2>/dev/null | head -n1)
      tasks_extra=$( ( load_agent "$(profile_get "$n" agent)"; agent_tasks_json "$n" ) 2>/dev/null ); [[ $tasks_extra == \[* ]] || tasks_extra="[]"
      jq -c --arg n "$n" --arg served "$served" --argjson running "$running" --arg window "${window:-}" --arg job "$(job_title "$n")" \
         --argjson recent "$recent" --argjson blockers "$blockers" --argjson extra "$tasks_extra" '
        ($recent | map(select(.agent == $n))) as $ev
        | ($blockers | to_entries | map(.value) | map(select(.agent == $n))) as $open
        | ($ev | map(select(.task != "" and .task != $job)) | group_by(.task) | map({source:"cli", id:.[-1].task, title:.[-1].task,
             status: (.[-1].kind | if . == "task_done" then "done" elif . == "task_blocked" then "blocked" elif . == "task_review" then "review" elif . == "task_started" then "running" else "noted" end)})) as $cli
        | . + {
            job_title: $job, running: $running, window: $window,
            role: (.role // "worker"), parent: (.parent // ""), backend: (.backend // .provider), task_title: (.task_title // ""),
            model_pinned: (.model // ""),
            model: (if (.provider == "local" and $served != "") then $served else .model end),
            signed_in: ((.signed_in // false) == true),
            last: ($ev | last // null | if . == null then null else {t, ts, kind, level, message} end),
            open_blockers: $open,
            status: (if ($open|length) > 0 then "blocked" elif $running then "running" elif (($ev|last // {}).kind == "job_done") then "done" else "idle" end),
            tasks: ([{source:"job", id:"job", title:$job, status:(if $running then "running" elif (($ev|last // {}).kind == "job_done") then "done" else "idle" end)}] + $cli + $extra)
          }' "$(profile_path "$n")"
    done < <(profile_list)
    printf ']}'
  } | jq -c '(.usage.agents | map({key: .name, value: {prompt, output, cost_usd, cost_unknown, sessions}}) | from_entries) as $u
             | .agents |= map(. + {usage: ($u[.name] // null)})'
}
cmd_status() { if (( JSON )); then cmd_status_json | jq .; else cmd_list; fi; }

# ------------------------------------------------------------- Jarvis & co ----
cmd_usage() { if (( JSON )); then usage_json | jq .; else usage_print; fi; }

cmd_jarvis() {
  case "${CMD[1]:-chat}" in
    setup)     jarvis_setup "${CMD[2]:-}" "${CMD[3]:-}" ;;
    chat|open) jarvis_exists || jarvis_setup; cmd_launch "$JARVIS_NAME" ;;
    brief)     jarvis_brief ;;
    ask)       jarvis_ask "${CMD[2]:?jarvis ask needs a question}" ;;
    status)    jarvis_status_json | jq . ;;
    *) fail "usage: omarchy-agent-launcher jarvis [chat|setup [BACKEND [MODEL]]|brief|ask \"…\"|status]" ;;
  esac
}

# Hand a job to a worker agent on a backend. Jarvis calls this from its session
# (OAL_AGENT is set, so the worker records it as parent); you can too.
cmd_delegate() {
  local backend name title mode=unattended model
  backend=$(opt_value --backend) || fail "delegate: --backend is required (see: omarchy-agent-launcher backends list)"
  name=$(opt_value --name || echo "task-$(date +%m%d%H%M%S)"); name=$(slugify "$name")
  title=$(opt_value --task-title || echo "$name"); model=$(opt_value --model || true)
  opt_flag --interactive && mode=interactive
  local parent=${OAL_AGENT:-}; [[ -z $parent ]] && jarvis_exists && parent=$JARVIS_NAME
  local -a create=(--name "$name" --agent hermes --runtime local --backend "$backend" --mode "$mode" --role worker --task-title "$title")
  [[ -n $parent ]] && create+=(--parent "$parent")
  [[ -n $model ]] && create+=(--model "$model")
  local i; for ((i=0; i<${#OPTS[@]}; i++)); do
    case "${OPTS[i]}" in
      --skill) create+=(--skill "${OPTS[i+1]}"); ((i++)) ;;
      --job-file) create+=(--job-file "${OPTS[i+1]}"); ((i++)) ;;
      --job-stdin|--job-env) create+=("${OPTS[i]}") ;;
    esac
  done
  local wait=0; opt_flag --wait && wait=1
  (( wait )) || create+=(--launch)
  local saved_json=$JSON; JSON=0
  OPTS=("${create[@]}"); cmd_create      # prints "saved <name>", then launches (or dry-run lines)
  JSON=$saved_json
  if (( wait )); then
    load_profile_adapters "$name"
    if (( OAL_DRY_RUN )); then local -a cmd; mapfile -t cmd < <(rt_cmd "$name" 0); say "[dry-run] would run and wait for:"; show_cmd "${cmd[@]}"
    else session_run_once "$name" 0 >/dev/null 2>&1 || true; cmd_result "$name"; fi
  else
    jq -c --arg backend "$backend" '{name, backend: $backend, model, mode, parent: (.parent // ""), task_title, result: ("omarchy-agent-launcher result " + .name)}' "$(profile_path "$name")"
  fi
}

# Latest (or every) unattended run output of an agent, ANSI stripped.
cmd_result() {
  local name=$1; profile_exists "$name" || fail "no saved agent named '$name'"
  local dir; dir="$(stage_dir "$name")/runs"
  if opt_flag --list; then ls -1 "$dir" 2>/dev/null || say "no runs yet"; return 0; fi
  local latest; latest=$(ls -1t "$dir"/*.log 2>/dev/null | head -n1)
  [[ -n $latest ]] || { say "no unattended run recorded for $name yet"; return 1; }
  say "# $name · $(basename "$latest" .log)"
  LC_ALL=C sed -E 's/\x1B\[[0-9;?]*[ -\/]*[@-~]//g; s/\r$//' "$latest"   # C locale: byte ranges, not collation order
}

# In a --popup terminal the window closes on success; hold it so the result stays readable.
popup_hold() { [[ ${OAL_POPUP:-0} == 1 ]] && { hr; read -rp "Press Enter to close…" _; }; return 0; }

cmd_backends() {
  local id=${CMD[2]:-}
  case "${CMD[1]:-list}" in
    list)   if (( JSON )); then backends_list_json | jq .; else backends_print; fi ;;
    show)   backend_get "${id:?backends show needs an id}" | jq . ;;
    add)    backend_add_from_opts | jq . ;;
    remove) backend_exists "${id:?backends remove needs an id}" || fail "no such backend: $id"; backend_delete "$id"; say "removed backend $id" ;;
    deploy|start) modal_backend_up "${id:?backends ${CMD[1]} needs an id}"; popup_hold ;;
    stop)   modal_backend_down "${id:?backends stop needs an id}"; popup_hold ;;
    test)   modal_backend_test "${id:?backends test needs an id}"; popup_hold ;;
    *) fail "usage: omarchy-agent-launcher backends list|show ID|add --id ID --kind K …|remove ID|deploy ID|start ID|stop ID|test ID" ;;
  esac
}

# Register/clear a provider's API key without it ever touching argv or a shell
# history entry: the value comes from $OAL_API_KEY only, same convention as
# `create --api-key-env`. set-key never prints the value back.
cmd_providers() {
  local id=${CMD[2]:-}
  case "${CMD[1]:-list}" in
    list) providers_all_ids | while read -r p; do
            [[ -n $p ]] || continue
            local env; env=$(provider_env "$p")
            local state=ready
            if [[ $env != - ]]; then [[ -n $(secret_get "$env") ]] || state="needs $env"; fi
            printf '%-16s %-32s %s\n' "$p" "$(provider_label "$p")" "$state"
          done ;;
    set-key)
      [[ -n $id ]] || fail "providers set-key needs a provider id"
      provider_label "$id" >/dev/null 2>&1 || fail "providers set-key: unknown provider '$id'"
      local var; var=$(provider_env "$id")
      [[ $var != - ]] || fail "providers set-key: $id takes no API key"
      [[ -n ${OAL_API_KEY:-} ]] || fail "providers set-key: \$OAL_API_KEY is empty (export it right before this call, never on the same line as other commands, then unset it)"
      secret_set "$var" "$OAL_API_KEY"
      say "saved $var (${#OAL_API_KEY} chars) — never printed" ;;
    clear-key)
      [[ -n $id ]] || fail "providers clear-key needs a provider id"
      local var; var=$(provider_env "$id")
      [[ $var != - ]] || fail "providers clear-key: $id takes no API key"
      if [[ -f $OAL_SECRETS ]] && grep -q "^$var=" "$OAL_SECRETS"; then
        local tmp; tmp=$(mktemp "$OAL_CONF/.secrets.XXXXXX")
        grep -v "^$var=" "$OAL_SECRETS" >"$tmp"; chmod 600 "$tmp"; mv -f "$tmp" "$OAL_SECRETS"
      fi
      say "cleared $var" ;;
    *) fail "usage: omarchy-agent-launcher providers list|set-key ID|clear-key ID   (set-key reads \$OAL_API_KEY, never argv)" ;;
  esac
}

cmd_modal() {
  case "${CMD[1]:-status}" in
    status) modal_status_json | jq . ;;
    gpus)   if (( JSON )); then modal_gpus_json | jq .; else modal_gpus_json | jq -r '"Modal GPUs (USD per GPU-hour, modal.com/pricing as of \(.prices_date)):", (.gpus[] | "  \(.id)\t\(.vram_gb) GB\t$\(.hourly_usd)/h\tsuggested: \(.suggested_model)")' | column -t -s $'\t'; fi ;;
    setup)  modal_installed || fail "install the modal CLI first: pipx install modal  (or: uv tool install modal)"; run modal setup; popup_hold ;;
    *) fail "usage: omarchy-agent-launcher modal status|gpus|setup" ;;
  esac
}

cmd_event() { # event <agent> <kind> <message> [--task T] [--level L] [--key K]
  local agent=${CMD[1]:-} kind=${CMD[2]:-} message=${CMD[3]:-}
  [[ -n $agent && -n $kind && ( -n $message || $kind == blocker_cleared ) ]] || fail "usage: omarchy-agent-launcher event <agent> <kind> \"<message>\" [--task T] [--level info|warn|blocker] [--key K]"
  local -a extra=()
  local v
  v=$(opt_value --task) && extra+=(--task "$v")
  v=$(opt_value --level) && extra+=(--level "$v")
  v=$(opt_value --key) && extra+=(--key "$v")
  [[ $kind == blocker ]] && ! opt_value --level >/dev/null && extra+=(--level blocker)
  event_emit "$agent" "$kind" "$message" --source cli "${extra[@]}"
}

cmd_settings() {
  case "${CMD[1]:-}" in
    get) settings_get "${CMD[2]:?settings get <key>}" ""; echo ;;
    set) settings_set "${CMD[2]:?settings set <key> <value>}" "${CMD[3]:?settings set <key> <value>}"; say "ok" ;;
    *)   [[ -f $OAL_CONF/settings.json ]] && jq . "$OAL_CONF/settings.json" || say "{}" ;;
  esac
}

# Graphical quick switcher: pick an agent, jump to its chat.
cmd_switch() {
  local -a rows=(); local n status model
  while IFS= read -r n; do
    [[ -n $n ]] || continue
    status=idle; session_alive "$n" && status=running
    [[ $(blockers_json | jq --arg n "$n" '[.[] | select(.agent == $n)] | length') -gt 0 ]] && status=blocked
    model=$(profile_get "$n" model)
    rows+=("$(printf '󱚝\t%s\t%s · %s' "$n" "$status" "$model")")
  done < <(profile_list)
  (( ${#rows[@]} )) || fail "no saved agents yet (open the dashboard to create one)"
  local pick
  if (( OAL_DRY_RUN )); then say "[dry-run] would offer:"; printf '  %s\n' "${rows[@]}"; return 0; fi
  if have omarchy-menu-select; then
    pick=$(omarchy-menu-select "Agent" "${rows[@]}" 2>/dev/null) || return 130   # returns "<name><TAB><subtext>"
  else
    ui_need; pick=$(choose "Agent" "${rows[@]}") || return 130                 # returns the full row
  fi
  n=$(awk -F'\t' '{ if ($1 == "󱚝") print $2; else print $1 }' <<<"$pick")
  profile_exists "$n" || fail "unknown agent: $pick"
  cmd_launch "$n"
}

cmd_local_server() {
  case "${CMD[1]:-status}" in
    status) if (( JSON )); then local_status_json | jq .; else say "$(local_status_line)"; local_status_json | jq -r '"  url \(.url) · unit \(if .unit_active then "active" else "inactive" end) · tuned \(.tuned)" + (if .gpu then "\n  GPU \(.gpu.name): \(.gpu.used_mib) / \(.gpu.total_mib) MiB used" else "" end) + "\n  models on disk: \(.models | join(", "))"'; fi ;;
    start)  local_ensure_running && say "$(local_status_line)" ;;
    tune)   local_tune "$(opt_value --ctx || echo 32768)" "$(opt_value --kv || echo q8_0)" "$(opt_value --slots || echo 1)" "$(opt_value --model || true)" ;;
    untune) local_untune ;;
    *) fail "usage: omarchy-agent-launcher local-server status|start|tune|untune" ;;
  esac
}

# Focus a window by exact title (the dashboard uses this on every summon, so a
# dashboard already open on another workspace is brought forward).
cmd_focus_window() {
  local t=$1 addr
  if (( OAL_DRY_RUN )); then focus_address "<address of '$t'>"; return 0; fi
  addr=$(window_address_by_title "$t")
  [[ -n $addr ]] || fail "no window titled '$t'"
  focus_address "$addr"
}

# ==================================================================== main ====
case "${CMD[0]:-menu}" in
  menu)    cmd_menu ;;
  new)     cmd_new ;;
  manage)  cmd_manage ;;
  info)    cmd_info ;;
  create)  cmd_create ;;
  launch)  cmd_launch "${CMD[1]:?launch needs a name}" ;;
  chat|open) cmd_launch "${CMD[1]:?chat needs a name}" ;;
  session) cmd_session "${CMD[1]:?session needs a name}" ;;
  sign-in) cmd_sign_in "${CMD[1]:?sign-in needs a name}" ;;
  list)    cmd_list ;;
  show)    cmd_show "${CMD[1]:?show needs a name}" ;;
  job)     cmd_job "${CMD[1]:?job needs a name}" ;;
  remove)  cmd_remove "${CMD[1]:?remove needs a name}" ;;
  destroy) cmd_destroy "${CMD[1]:?destroy needs a name}" ;;
  console) cmd_console "${CMD[1]:?console needs a name}" ;;
  stop)    cmd_stop "${CMD[1]:?stop needs a name}" ;;
  status)  cmd_status ;;
  event)   cmd_event ;;
  settings) cmd_settings ;;
  switch)  cmd_switch ;;
  kanban-sync) cmd_kanban_sync "${CMD[1]:-}" ;;
  local-server) cmd_local_server ;;
  usage)    cmd_usage ;;
  jarvis)   cmd_jarvis ;;
  delegate) cmd_delegate ;;
  result)   cmd_result "${CMD[1]:?result needs a name}" ;;
  backends) cmd_backends ;;
  providers) cmd_providers ;;
  fallback) cmd_fallback "${CMD[@]:1}" ;;
  modal)    cmd_modal ;;
  focus-window) cmd_focus_window "${CMD[1]:?focus-window needs a window title}" ;;
  *) fail "unknown command: ${CMD[0]} (try --help)" ;;
esac
