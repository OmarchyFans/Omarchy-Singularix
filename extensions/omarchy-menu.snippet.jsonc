  // Omarchy Agent Launcher — append inside ~/.config/omarchy/extensions/omarchy-menu.jsonc
  "agents": {"icon":"󱚝","label":"Agents","aliases":["agent-launcher","dashboard","launch-agent"],"description":"Agent Dashboard: create, launch, switch, events, notifications"},
  "agents.dashboard": {"icon":"󰕮","label":"Dashboard","description":"Agents, status, events, notifications (persistent window)","action":"omarchy-shell shell summon fans.omarchy.singularix '{}'"},
  "agents.new": {"icon":"","label":"New agent","description":"One-page setup: agent, runtime, model, sign-in, skills, job","action":"omarchy-shell shell summon fans.omarchy.singularix '{\"tab\":\"new\"}'"},
  "agents.switch": {"icon":"󰭹","label":"Switch agent","description":"Jump to an agent's chat","when":"compgen -G \"$HOME/.config/omarchy-agent-launcher/agents/*.json\"","action":"$HOME/.config/omarchy/plugins/fans.omarchy.singularix/bin/omarchy-agent-launcher switch"},
  "agents.notifications": {"icon":"󰂚","label":"Needs you","description":"Open blockers and notifications","action":"omarchy-shell shell summon fans.omarchy.singularix '{\"tab\":\"notifications\"}'"},
